# Configure only in the local process; never commit a real token.
CATEGORY_AI_TOKEN=
# Optional: an already installed Ollama model with local weights. Blank = no LLM.
CATEGORY_AI_MODEL=
# Launcher controls these process variables; see docs/llm-nuvem.md for protected Groq credentials.
# CATEGORY_AI_PROVIDER=none|ollama|groq
# Do not place an actual key here or use a frontend VITE_ variable for it.

# Copie para .env e escolha uma senha local longa.
DB_NAME=java_finance
DB_USER=java_finance
DB_PASSWORD=troque-esta-senha-local
APP_PORT=8080
# Ative só enquanto criar seus usuários; desative depois e reinicie o app.
REGISTRATION_ENABLED=false
COOKIE_SECURE=false
# Meu Pluggy pessoal: nunca preencher estas chaves em arquivos públicos ou enviar no chat.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_OWNER_ID=
PLUGGY_ITEM_IDS=

